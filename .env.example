# 复制为 .env 并按需修改；真实密钥不要提交。
DIARY_BIND=127.0.0.1:8787
DIARY_DB_PATH=./data/diary.db
# base64，解码后至少 32 字节：head -c32 /dev/urandom | base64 -w0
DIARY_JWT_SECRET=
# base64，解码后必须正好 32 字节
DIARY_MASTER_KEY=
# 逗号分隔、精确匹配的 origin 白名单
DIARY_CORS_ORIGINS=http://localhost:5173
DIARY_ALLOW_REGISTRATION=true
# 生产环境必须为 true（本地 HTTP 调试可设 false）
DIARY_SECURE_COOKIE=false
DIARY_ACCESS_TTL_SECS=900
DIARY_REFRESH_TTL_SECS=2592000
DIARY_MFA_TOKEN_TTL_SECS=300
DIARY_TOTP_SKEW=1
DIARY_TWOFA_DISABLE_DELAY_DAYS=7
DIARY_MAX_ENTRY_BYTES=1048576
DIARY_MAX_EXPORT_BYTES=67108864
DIARY_MAX_IMPORT_BYTES=67108864
DIARY_MAX_TAGS=200
DIARY_MAX_TAGS_PER_ENTRY=20
DIARY_RUST_LOG=info
