# diary: 同源托管 SPA + 反向代理 /api，推荐前后端 same-site。
# 将域名、证书路径、静态目录按实际情况替换。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name app.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name app.example.com;

    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;

    root /srv/diary/web/build;
    index index.html;

    # 安全响应头（HTTPS 与 CSP 是前端加密可用的前提）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # 其余 CSP 由 SvelteKit 构建产物 index.html 中的 <meta> 提供（含脚本 hash）。
    # meta CSP 不支持 frame-ancestors，因此这里单独补一条。
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # 静态资源长缓存；index.html 不缓存，保证升级后立即生效。
    location /_app/immutable/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 单层反代：覆盖而不是追加，避免客户端伪造 X-Forwarded-For 绕过限流。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 66m;   # 导入明文上限 64 MiB + JSON 包装余量
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
